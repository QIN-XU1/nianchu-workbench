!plugins/**

# 提交信息临时文件
_commit_msg.txt

# 提交信息临时文件
_msg.txt
_commit_msg.txt

# 备份（本地快照，不进 git）
workbench/备份/

# CI 日志
workbench/外壳/data/ci-log.txt

# 回滚快照（体积大，本地保留即可）
workbench/数据/.dsh/回滚快照/

# 参考项目（外部仓库，体积大，本地保留）
参考项目/

# DSH 沙箱专用临时目录（低完整性标签，本机生成）
workbench/数据/.dsh-temp/


# 破坏性验证的跑前快照（运行产物，不入版本控制）
workbench/数据/.dsh/破坏性验证快照/

# ══════════════════════════════════════════════════════════════════════
#  打包产物（2026-11-13 加）
# ══════════════════════════════════════════════════════════════════════
#  electron-builder 的输出目录。实测：
#    dist/   347 MB
#    dist2/  466 MB
#  这些是**可再生产物**（有源码 + 一条 build 命令就能重建），
#  不该进版本控制 —— 会让仓库涨 800 MB 且每次构建都产生巨大 diff。
#
#  打包方法见 workbench/外壳/electron-builder.config.js
dist/
dist2/
workbench/外壳/build/*.blockmap


# ══════════════════════════════════════════════════════════════════════
#  环境依赖与第三方源码（2026-11-14 加）
# ══════════════════════════════════════════════════════════════════════
#  hermes 完整源码（MIT）作为设计参考，243 MB / 25514 文件
#  不纳入版本控制：它是上游代码，需要时重新下载即可
hermes/
node26/
pnpm12/
npm-cache/
npm-cache2/
pnpm-store/
pnpm-home/
corepack/
pydeps/
tmp/
electron44.zip
pnpm-exe.tgz
pnpm12.tgz
*.zip

#  prototype 下的临时脚本与截图
prototype/*.mjs
prototype/*.ps1
prototype/shots/
prototype/hermes/
prototype/tmp-main.js


dist3/


# 界面调研：原始 HTML 可重抓，不进仓（截图进仓作为证据）
research/ui-survey/raw/

# A15 审批验证的临时金丝雀目录（每次测试重建，不进仓）
.tmp-a15/
a15-*

# 界面验证的临时截图（每次验收重写，像素不确定）
#
#   为什么不能直接写进 research/screenshots/：星图是 canvas 动画，两次截图像素
#   不同（实测 186822 → 187296 字节），于是**每跑一次验收就把仓库搞脏**，
#   R8 的「未提交 0 项」永远是红的 —— 不是产品问题，是取证方式的问题。
#
#   这条正好是 .gitignore 开头判据的应用：星图一条命令能重生成 → 不进 git。
#   要给仓里留证据时用 verify-starmap.mjs --save 显式写进 research/screenshots/。
research/ui-survey/scratch/

node_modules/
apps/agent-ui/node_modules/
apps/agent-ui/dist/
*.tsbuildinfo

# OpenBitFun fork：依赖与构建产物不入库
apps/bitfun-web/node_modules/
apps/bitfun-web/dist/
apps/bitfun-web/src/web-ui/dist/
apps/bitfun-web/**/node_modules/
apps/bitfun-web/design-system/packages/*/dist/
# 从 asar 解出的 dsh 源码（可随时用 tools/net/extract-dsh-src.mjs 重建）
evidence/dsh-src/
# 验收运行产物：每次跑都会带新时间戳，不入库（否则 git 永远「有未提交」）
#   R8 的判据是「改动进 git」，不该被这些产物污染
evidence/density.json
evidence/size-guard.json

# 运行时状态产物：每次采集都带新时间戳，不入库（否则 R8 永远「有未提交」）
evidence/runtime-state.json
apps/agent-ui/src/data/runtime-state.json

# 调度器 job 存储：每次运行都变，不入库（job 定义在 README 与 seed 脚本里）
evidence/schedule/jobs.json

# 真 MCP server 的依赖（95 包，npm i 即可重建）
evidence/mcp-realserver/node_modules/

# 单次搜索的临时结果（net.json 入库，因为它是界面数据源）
evidence/net/search.json

# 记忆存储：每次 put 都变，不入库（memory.json 入库，它是界面数据源）
evidence/memory/store.json

# L4 自我改进闭环的运行产物：每次度量都带新时间戳与新的 recall 值，不入库
#   （同样会污染 R8 —— 实测：度量跑完 tree 就脏，F07 用例失去区分力）
# 但审计报告（.md）不可再生，必须入库 —— 否则「引用一份不存在的证据」就是假绿
evidence/evolve/*
!evidence/evolve/*.md

# C6 成本台账与价格快照：每次同步/记账都变，不入库（机制在代码里）
evidence/cost/

# 出厂交付物（大 zip，不入库）
出厂/

# 插件探针每次激活都会重写产物（机制在代码里，产物不入库）
evidence/plugin-probe/

# 可移植清单每次导出都会重写（机制在代码里）
evidence/portable/

# 运行时产物：每次连 WS 宿主都会重写，不该污染工作树
# （静态清点 evidence/host-api/inventory.json 仍然跟踪）
evidence/host-api/runtime-demand.json

# 调度器运行时状态：常驻 daemon 每个 tick 都会重写（runs/lastRunMinute/guard），
# 属于运行时产物而非源码；进 git 会让工作树一直脏，导致 R8/R9 误红。
evidence/schedule/jobs.json

# ── 审计/调试临时目录（2026-11-18 加）──────────────────────────
# 起因：独立审计员在 _audit_tmp/ 下写临时脚本，我的 git add -A 把它们一并提交了。
# 这已经是「临时文件被误提交」的第五次（前四次是 imporo / fault-probe 残留）。
# 原则：一次性脚本一律放这些目录，且这些目录永不入库。
_audit_tmp/
_debug_tmp/
*.tmp.mjs

# 多宿主投影生成产物（由 tools/portable/project.mjs 重新生成）
.nianchu-hosts/

# ── 根目录一次性探针 / 本地 scratch（2026-11-22 加）────────────
# 起因：做「主题模式」时在仓库根逐个写 CDP 探针（probe-theme-nav1..8 这类），
# 一次改一个猜测就新建一个文件，前后 120 多个，全落在根目录。
# 它们的**结论**已经进了 evidence/theme-mode.json 与改进台账，
# 文件本身是一次性的（跑一次就过期），留着只会让 git status 永远一片红。
# 原则同 _audit_tmp/：一次性脚本放目录里，且目录永不入库。
# ⚠ 全部用 `/` 开头锚到仓库根 —— 否则 `scan-*.mjs` 会把 tools/quality/ 下的
#   正式扫描器一起吞掉（实测：7 个 scan-* 脚本、20 张 shot-*.png 被误伤）。
/temp/
/.tmp-shots/
/.tmp-audit-check.mjs
/.tmp-serve-static.cjs
/probe-*.mjs
/probe-*.cjs
/probe-*.png
/probe[0-9]*.mjs
/probe[0-9]*.cjs
/shot-*.png
/scan-*.mjs
/diag-*.mjs

# 宿主运行时产物：探针写进去的测试配置与用量账本，每次跑都变
/.host-config.json
/.host-usage.json

