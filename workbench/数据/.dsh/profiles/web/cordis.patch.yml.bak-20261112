# 公开模板 patch：只挂「启动动画」
- insert:
    - id: boot-anim-host
      name: dsh-plugin-boot-anim
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: pursueray
    model: deepseek-v4-pro
- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      pursueray:
        apiKeyEnv: PURSUERAY_API_KEY
        displayName: PursuerRay
        api: openai-completions
        baseURL: https://api.pursueray.cn/v1
        models:
          - id: deepseek-v4-pro
            name: DeepSeek V4 Pro
            contextWindow: 128000
            maxTokens: 8192
          - id: deepseek-v4-flash
            name: DeepSeek V4 Flash
            contextWindow: 128000
            maxTokens: 8192
          - id: deepseek-flash
            name: DeepSeek Flash
            contextWindow: 128000
            maxTokens: 8192
          - id: grok-4.7
            name: Grok 4.7
            contextWindow: 128000
            maxTokens: 8192
          - id: kimi-k3.1-pro
            name: Kimi K3.1 Pro
            contextWindow: 128000
            maxTokens: 8192
          - id: qwen3.8-max
            name: Qwen 3.8 Max
            contextWindow: 128000
            maxTokens: 8192
          - id: glm-5.3
            name: GLM 5.3
            contextWindow: 128000
            maxTokens: 8192
          - id: gpt-6-astra-1022
            name: GPT-6 Astra
            contextWindow: 128000
            maxTokens: 8192
        defaultContextWindow: 128000
        defaultMaxTokens: 8192
        transport: sse
- id: ui-settings-general
  name: "@deepseek-ai/dsh-client-ui-settings-general"
  config:
    welcomeNoticeVersion: 2026-09-28.1

# ══════════════════════════════════════════════════════════════════════
#  ⚠ 2026-11-11 尝试过的方案：additionalWritableRoots（已回滚）
#
#  问题：场景 agent 被沙箱限制在自己的记忆目录内，但派单台账是跨场景
#        共享的，写不进去 → EPERM → agent 请求升级 → 没人批准 → 卡死。
#
#  尝试：用 sandbox-policy 的 additionalWritableRoots 加共享目录。
#
#  实测结果（失败）：
#    场景 agent 一跑命令就报：
#      Error: Windows ACL confinement does not support additional
#             writable directories; remove the extra grants or use a
#             supported host
#
#  结论：**Windows ACL 沙箱后端明确不支持额外可写目录**，这条路被引擎堵死。
#
#  换方案：不让场景 agent 直接写台账，改由「中枢侧的工具」代写。
#  场景 agent 只需要把结果回复在会话里，中枢用 投递通道 等待并读取，
#  然后由中枢（不受场景沙箱限制）去更新台账。
#
#  也就是说：**把跨目录的写操作从场景侧移到中枢侧**，
#  场景 agent 只负责「做和说」，不负责「记账」。
#
#  配置已回滚，此文件恢复原状。
# ══════════════════════════════════════════════════════════════════════
