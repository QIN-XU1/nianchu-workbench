{
  "name": "@local/sea-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 sea 的体检结果搬进 DSH 界面：一眼看到有没有事、检查可不可信、资产有没有超红线。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
